# ===== پژوهش و جستجو: تنظیمات =====
# این فایل را با نام .env کپی کنید و مقادیر را ویرایش کنید.
# توضیح هر متغیر در خط بالای آن آمده است (کامنت را کنار مقدار ننویسید).

# ارائه‌دهنده‌ی مدل زبانی: ollama (محلی) یا openai_compatible (مثل GapGPT)
LLM_PROVIDER=ollama

# --- تنظیمات Ollama (وقتی LLM_PROVIDER=ollama است) ---
# آدرس سرور Ollama
OLLAMA_HOST=http://127.0.0.1:11434
# نام مدل محلی (ابتدا: ollama pull qwen3:4b)
OLLAMA_MODEL=qwen3:4b

# --- تنظیمات API سازگار با OpenAI (وقتی LLM_PROVIDER=openai_compatible است) ---
# آدرس پایه‌ی API، بدون /chat/completions در انتها (آدرس دقیق را از مستندات سرویس بردارید)
BASE_URL=
# کلید API
API_KEY=
# نام مدل در آن سرویس
MODEL=

# سقف انتظار برای پاسخ هر درخواست به مدل (ثانیه)
LLM_TIMEOUT_SECONDS=180

# --- محدودیت‌ها ---
# حداکثر زمان هر پژوهش (ثانیه). بعد از آن گزارش جزئی ساخته می‌شود.
JOB_TIMEOUT_SECONDS=300
# مدت نگهداری کارها در حافظه پس از ساخت (ثانیه)
JOB_TTL_SECONDS=3600
# حداکثر تعداد پژوهش هم‌زمان
MAX_CONCURRENT_JOBS=3

# --- موتور جستجوی جایگزین ---
# اگر DuckDuckGo در دسترس نبود، از این SearXNG استفاده می‌شود (مثلاً http://127.0.0.1:8080). خالی = غیرفعال
SEARCH_FALLBACK_URL=

# --- سرور ---
# پورت (برای اجرای uvicorn با --port از همین مقدار استفاده کنید)
PORT=8000
# مسیر پایگاه‌داده‌ی تاریخچه
DB_PATH=data/pazhuhesh_jostejoo.db
